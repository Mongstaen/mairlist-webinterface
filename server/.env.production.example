# Production configuration for Windows Server deployment (<SERVER-IP>:8841)
# Copy to .env and adjust the values. Do NOT commit .env.

# Port the Node process (API + frontend) listens on
PORT=8841

# Data source for the library routes (items/folders/playlists/audio):
#   "sqlite" - direct access to the mAirList .mldb file (better-sqlite3)
#   "api"    - access via the mAirListDB server REST API (see API_DB_*
#              below); avoids SQLite lock conflicts with mAirList, but
#              doesn't yet cover all functions (e.g. storage management,
#              search, dashboard) - those return an error in api mode.
#   "mock"   - in-memory test data, no real mAirList access
# User management/login always runs independently of this via the
# existing logic (unaffected by DATA_SOURCE).
DATA_SOURCE=sqlite

# Path to the mAirList SQLite DB on the server (only for DATA_SOURCE=sqlite)
DB_PATH=C:\mAirList\Data\mairlist.mldb

# mAirListDB server REST API (only for DATA_SOURCE=api)
# API_DB_BASE_URL=http://localhost:8840
# API_DB_USER=
# API_DB_PASSWORD=
# API_DB_STATION=1
# Maximum concurrent requests to the mAirListDB server (default 3).
# Deliberately kept below its MaxCachedConnections limit (default 5 in
# dbserver.ini) so there's headroom for other clients (a real mAirList
# client) and the server doesn't respond with "database is locked"
# (500) when the frontend fires many requests in parallel.
# API_DB_MAX_CONCURRENT=3

# Base directory for uploads (e.g. jingles, cover art)
UPLOAD_BASE_DIR=C:\mAirList\Data\Uploads

# Password for the webinterface's initial admin account (only relevant
# on first start, when no user exists yet). If empty, a random password
# is generated and printed once to the server log.
INITIAL_ADMIN_PASSWORD=

# Brute-force protection on login: after LOGIN_MAX_ATTEMPTS failed
# attempts, the combination (username or IP) is locked for
# LOGIN_LOCKOUT_MINUTES. The counters live in memory and are cleared on
# restart.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Set to true if the webinterface runs over HTTPS. The session cookie
# will then only be transmitted over encrypted connections. For plain
# HTTP operation this must stay false, otherwise login fails.
COOKIE_SECURE=false

# Allowed origins for CORS, comma-separated.
# For a single-origin deploy (API + frontend on the same port), your own URL is enough.
ALLOWED_ORIGINS=http://<SERVER-IP>:8841
